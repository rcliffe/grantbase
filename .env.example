# Copy to `.env` and replace every placeholder. Never commit `.env`.
# Generate secrets with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# Local MariaDB container (docker compose)
# ---------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=replace-with-a-random-root-password
MARIADB_DATABASE=grantbase
MARIADB_USER=grantbase
MARIADB_PASSWORD=replace-with-a-random-app-password
# Host port for the container (3306 inside). Change if 3306 is already in use.
MARIADB_PORT=3306

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Prisma connection URL. User, password, port and database must match the values above.
# URL-encode any special characters in the password.
DATABASE_URL=mysql://grantbase:replace-with-a-random-app-password@127.0.0.1:3306/grantbase
# Used only by `prisma migrate dev` (created automatically by docker/mariadb/init).
SHADOW_DATABASE_URL=mysql://grantbase:replace-with-a-random-app-password@127.0.0.1:3306/grantbase_shadow
# Used only by the test suite. Tests TRUNCATE this database, so never point it at real data.
TEST_DATABASE_URL=mysql://grantbase:replace-with-a-random-app-password@127.0.0.1:3306/grantbase_test

# Secret used to sign session cookies. At least 32 random characters.
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Public base URL of the app. Must be https:// in production.
BETTER_AUTH_URL=http://localhost:3000

# Number of trusted reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = app is reached directly (development). Set to 1 behind a single load balancer/proxy.
TRUSTED_PROXY_COUNT=0

# Production with more than one instance: a stable key shared by all instances so
# Server Action references stay valid. Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
