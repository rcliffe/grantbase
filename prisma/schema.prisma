// Prisma schema. Apply changes with `npm run db:migrate` (creates a migration).
//
// The User, Session, Account and Verification models follow the shape Better Auth
// expects (https://www.better-auth.com/docs/concepts/database#core-schema).
// Field names must stay as they are; table names are mapped to snake_case plurals.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMINISTRATOR
  EDITOR
  VIEWER
}

model User {
  id               String    @id @default(cuid()) @db.VarChar(36)
  name             String    @db.VarChar(200)
  /// Always stored normalised (trimmed, NFC, lower-case). See lib/email.ts.
  email            String    @unique @db.VarChar(320)
  emailVerified    Boolean   @default(false)
  image            String?   @db.Text
  role             Role      @default(VIEWER)
  /// Deactivated users cannot sign in and have all sessions revoked.
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @db.DateTime(3)
  sessions         Session[]
  accounts         Account[]
  charitiesCreated Charity[] @relation("CharityCreatedBy")
  charitiesUpdated Charity[] @relation("CharityUpdatedBy")
  grantsCreated    Grant[]   @relation("GrantCreatedBy")
  grantsUpdated    Grant[]   @relation("GrantUpdatedBy")

  @@index([role, active])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(36)
  /// Opaque random token. The cookie carries this token plus an HMAC signature.
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @db.DateTime(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Credential store. For email/password sign-in, providerId = "credential" and
/// `password` holds the Argon2id hash. Never select this model into UI code.
model Account {
  id                    String    @id @default(cuid()) @db.VarChar(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid()) @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verifications")
}

/// Fixed-window counters for rate limiting, shared by all app instances.
/// `key` is a SHA-256 hash, so no e-mail addresses or IPs are stored in clear.
model RateLimit {
  key     String   @id @db.Char(64)
  count   Int
  resetAt DateTime @db.DateTime(3)

  @@index([resetAt])
  @@map("rate_limits")
}

/// A charity organisation. Registration number is optional (exempt/excepted charities)
/// but unique when present, stored upper-case without spaces.
model Charity {
  id                 String   @id @default(cuid()) @db.VarChar(36)
  name               String   @db.VarChar(200)
  registrationNumber String?  @unique @db.VarChar(20)
  yearEstablished    Int?     @db.SmallInt
  /// Brief plain-text description of the organisation.
  description        String?  @db.VarChar(1000)
  addressLine1       String?  @db.VarChar(200)
  addressLine2       String?  @db.VarChar(200)
  town               String?  @db.VarChar(100)
  county             String?  @db.VarChar(100)
  postcode           String?  @db.VarChar(20)
  country            String?  @db.VarChar(100)
  /// The person who applies on the charity's behalf.
  contactName        String?  @db.VarChar(200)
  contactPosition    String?  @db.VarChar(200)
  contactEmail       String?  @db.VarChar(320)
  /// Always an absolute http(s) URL (validated before storage).
  website            String?  @db.VarChar(500)
  createdById        String?  @db.VarChar(36)
  createdBy          User?    @relation("CharityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?  @db.VarChar(36)
  updatedBy          User?    @relation("CharityUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @db.DateTime(3)
  updatedAt          DateTime @updatedAt @db.DateTime(3)
  grants             Grant[]

  @@index([name])
  @@index([town])
  @@map("charities")
}

/// Reference lists maintained by administrators (Administration → Grant categories /
/// Grant statuses). Both have the same shape so they share one service and UI.
model GrantCategory {
  id          String   @id @default(cuid()) @db.VarChar(36)
  /// Unique, case-insensitively (utf8mb4_unicode_ci).
  name        String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  /// Badge colour: one of LOOKUP_TONES in lib/grant-lookups.ts.
  tone        String   @default("neutral") @db.VarChar(20)
  /// Inactive entries stay on existing records but aren't offered for new ones.
  active      Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  grants      Grant[]

  @@index([sortOrder])
  @@map("grant_categories")
}

/// Where a status sits in the grant process (lib/grant-process.ts). Statuses without
/// a stage (Draft, Withdrawn …) aren't part of the decision/payment queues.
enum GrantStage {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model GrantStatus {
  id          String      @id @default(cuid()) @db.VarChar(36)
  name        String      @unique @db.VarChar(255)
  description String?     @db.VarChar(500)
  tone        String      @default("neutral") @db.VarChar(20)
  stage       GrantStage?
  active      Boolean     @default(true)
  sortOrder   Int
  createdAt   DateTime    @default(now()) @db.DateTime(3)
  updatedAt   DateTime    @updatedAt @db.DateTime(3)
  grants      Grant[]

  @@index([sortOrder])
  @@map("grant_statuses")
}

/// A grant application submitted by a charity. Charities, categories and statuses
/// can't be deleted while grants refer to them (onDelete: Restrict).
model Grant {
  id                  String        @id @default(cuid()) @db.VarChar(36)
  charityId           String        @db.VarChar(36)
  charity             Charity       @relation(fields: [charityId], references: [id], onDelete: Restrict)
  categoryId          String        @db.VarChar(36)
  category            GrantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusId            String        @db.VarChar(36)
  status              GrantStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  /// What the grant is for (plain text, line breaks kept).
  purpose             String?       @db.VarChar(4000)
  /// Calendar dates (no time of day).
  dateSubmitted       DateTime      @db.Date
  /// Pounds, to the penny.
  amountRequested     Decimal       @db.Decimal(12, 2)
  amountAgreed        Decimal?      @db.Decimal(12, 2)
  decisionDate        DateTime?     @db.Date
  paymentDate         DateTime?     @db.Date
  /// The charity's figures as stated in the application.
  accountsDate        DateTime?     @db.Date
  income              Decimal?      @db.Decimal(12, 2)
  expenditure         Decimal?      @db.Decimal(12, 2)
  governmentFunding   Decimal?      @db.Decimal(12, 2)
  otherFunders        String?       @db.VarChar(1500)
  /// Pence of each pound spent on charitable activities, 0–100.
  penceInPound        Int?          @db.TinyInt
  employees           Int?
  volunteers          Int?
  trustees            Int?
  /// ID of the online-form submission the grant was imported from, so a report
  /// can be imported again without adding the same application twice.
  submissionReference String?       @unique @db.VarChar(100)
  createdById         String?       @db.VarChar(36)
  createdBy           User?         @relation("GrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById         String?       @db.VarChar(36)
  updatedBy           User?         @relation("GrantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now()) @db.DateTime(3)
  updatedAt           DateTime      @updatedAt @db.DateTime(3)

  @@index([charityId, dateSubmitted])
  @@index([statusId])
  @@index([categoryId])
  @@index([dateSubmitted])
  @@map("grants")
}
